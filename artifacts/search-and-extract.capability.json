      "id": "enter-query",
      "action": {
        "kind": "type",
        "target": {
          "strategies": [
            {
              "kind": "stableId",
              "value": "query"
            }
          ],
          "requireUniqueMatch": true
        },
        "valueTemplate": "${query}"
      },
      "preconditions": [],
      "timeout": "00:00:15",
      "retry": {
        "maxAttempts": 1,
        "delay": "00:00:00",
        "recoverableConditionCodes": []
      },
      "risk": "safe"
    },
    {
      "id": "submit-search",
      "action": {
        "kind": "click",
        "target": {
          "strategies": [
            {
              "kind": "accessibleRoleAndName",
              "value": "button:Search"
            }
          ],
          "requireUniqueMatch": true
        }
      },
      "preconditions": [],
      "timeout": "00:00:15",
      "retry": {
        "maxAttempts": 1,
        "delay": "00:00:00",
        "recoverableConditionCodes": []
      },
      "risk": "safe"
    },
    {
      "id": "read-result",
      "action": {
        "kind": "read",
        "target": {
          "strategies": [
            {
              "kind": "css",
              "value": "#results > article > div > h3"
            }
          ],
          "requireUniqueMatch": true
        },
        "outputName": "title"
      },
      "preconditions": [],
      "timeout": "00:00:15",
      "retry": {
        "maxAttempts": 4,
        "delay": "00:00:00.2500000",
        "recoverableConditionCodes": [
          "target-not-found"
        ]
      },
      "risk": "safe"
    }
  ],
  "outcomes": [
